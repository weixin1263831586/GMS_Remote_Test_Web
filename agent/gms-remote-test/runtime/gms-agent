    safe_extract,
    write_profile,
)
from gms_agent.package_manager import MAX_ARCHIVE_FILES, MAX_ARCHIVE_BYTES  # noqa: E402,F401
import gms_agent.package_manager as _pm  # noqa: E402
import shutil as _shutil  # noqa: E402,F401  (re-export for tests/compat)

# Lifecycle functions read module globals from package_manager; tests and
# embedders patch states through this handle (see test_agent_package_lifecycle).
pm = _pm
shutil = _shutil

import argparse  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(prog="gms-agent", description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    p_install = sub.add_parser("install", help="install runtime + skill + MCP for detected clients")
    p_install.add_argument("--client", default="auto", choices=["auto", "codex", "kimi", "kkagent"])
    p_install.add_argument("--server", default="", help="Controller base URL (default $GMS_REMOTE_TEST_SERVER)")
    p_install.add_argument("--package", default="", help="package root to install (default: this archive; standalone script bootstraps from the registry)")
    p_install.set_defaults(func=cmd_install)

    p_update = sub.add_parser("update", help="update from the Controller Agent Package Registry")
    p_update.add_argument("--server", default="")
    p_update.add_argument("--force", action="store_true")
    p_update.set_defaults(func=cmd_update)

    p_rollback = sub.add_parser("rollback", help="switch `current` (and every client) back to an installed version")
    p_rollback.add_argument("version")
    p_rollback.set_defaults(func=cmd_rollback)

    p_enroll = sub.add_parser("enroll", help="exchange a one-shot enrollment code for a service token")
    p_enroll.add_argument("code")
    p_enroll.add_argument("--server", default="")
    p_enroll.set_defaults(func=cmd_enroll)

    p_status = sub.add_parser("status", help="show installation state")
    p_status.set_defaults(func=cmd_status)

    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
