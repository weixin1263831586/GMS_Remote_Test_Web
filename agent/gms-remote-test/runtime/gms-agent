#!/usr/bin/env python3
"""gms-agent — one installer, one updater, one enrollment (10.txt §十三~§十六).

The single user-facing entry point of the GMS Agent Runtime on a build
server. Users should never need to know about ~/.codex/config.toml,
~/.kimi-code/mcp.json, ~/.kkagent/plugins, GMS_AUTH_TOKEN_FILE or
GMS_RT_PROFILE — those become implementation details:

    gms-agent install [--client auto|codex|kimi|kkagent] [--server URL] [--yes]
        Detect installed agent clients and activate the whole package
        (runtime + skill + client registration) from either a local
        package tree (--package / extracted archive / plugin payload) or,
        when downloaded standalone via GET /api/agent/install, straight
        from the Controller Agent Package Registry.

    gms-agent update
        Check the Controller Agent Package Registry for a newer version,
        download + verify (SHA-256 + manifest/package version contract),
        install into versions/<new>/ (immutable per version) and re-activate
        every configured client from the new package — skill, kkagent
        plugin and MCP registrations refresh together with the runtime
        (whole-package activation, not runtime-only).

    gms-agent rollback <version>
        Flip `current` back to an installed version AND re-activate all
        configured clients from that version.

    gms-agent enroll <CODE>
        Exchange a one-shot enrollment code for an Agent Service Token
        (0600) and wire it into every configured client profile.

    gms-agent status
        Show installed version, detected clients, profile and auth state.

Package layout contract (single root, produced by
features/system/agent_package_builder.py and tools/build_agent_package.py):

    gms-remote-test/
      scripts/          gms-remote-test.sh, mcp_server.py, gms-agent, ...
      skills/gms-remote-test/
      tests/
      kk.plugin.json  kimi.plugin.json  .codex-plugin/plugin.json

Identity model: one host token shared by the client profiles (audit still
separates the client via GMS_AGENT_CLIENT metadata); per-client tokens can
be introduced later by enrolling with dedicated profiles.
"""

# Thin argparse shell (10.txt §三十四: the lifecycle logic lives in
# gms_agent.package_manager; this file stays the stable entry point so
# bootstrap downloads and existing muscle memory keep working).
#
# STANDALONE bootstrap (downloaded via GET /api/agent/install): this file
# ships alone, without the gms_agent package next to it. In that mode the
# shell delegates the ENTIRE run to the full gms-agent inside the registry
# package (download → verify → exec), instead of importing a module it does
# not carry. Two-layer lifecycle, exactly 10.txt §四.
import os
import runpy
import sys
import urllib.request
from pathlib import Path, PurePosixPath

SCRIPT_DIR = Path(__file__).resolve().parent
if str(SCRIPT_DIR) not in sys.path:
    sys.path.insert(0, str(SCRIPT_DIR))

if not (SCRIPT_DIR / "gms_agent" / "package_manager.py").is_file():
    # ---- standalone bootstrap: minimal, dependency-free fetch-and-exec ----
    # The embedded Controller URL replaces __GMS_AGENT_DEFAULT_SERVER__ at
    # download time; GMS_AGENT_VERIFY_KEY_B64 replaces
    # __GMS_AGENT_VERIFY_KEY_B64__ (release public-key pin, 10.txt §二十).

    def _bootstrap_server() -> str:
        # --server wins over the embedded default (same precedence the full
        # gms-agent applies), then $GMS_REMOTE_TEST_SERVER, then the URL the
        # Controller embedded at bootstrap download time.
        argv = sys.argv[1:]
        for index, token in enumerate(argv):
            if token == "--server" and index + 1 < len(argv):
                return argv[index + 1].rstrip("/")
            if token.startswith("--server="):
                return token.split("=", 1)[1].rstrip("/")
        url = (
            os.environ.get("GMS_REMOTE_TEST_SERVER", "")
            or "__GMS_AGENT_DEFAULT_SERVER__"
        )
        if not url or url.startswith("__GMS_"):
            print(
                "Error: GMS_REMOTE_TEST_SERVER 未设置（gms-agent 不会猜测 Controller 地址）",
                file=sys.stderr,
            )
            raise SystemExit(2)
        return url.rstrip("/")

    def _standalone_main() -> int:
        # Fetch the FULL registry package and verify the ENTIRE trust chain
        # BEFORE anything extracted is executed (11.txt 审核 P0-2):
        #   1. same-origin artifact URL (scheme+netloc, redirects rejected),
        #   2. SHA-256 of the downloaded bytes against the manifest,
        #   3. Ed25519 manifest signature against the release public key
        #      pinned into this bootstrap at download time (10.txt §二十) —
        #      when a key is pinned, an absent/invalid signature is fatal,
        #   4. only then a guarded extract (no traversal / symlink / bomb),
        #   5. and only then exec the package's gms-agent with all original
        #      arguments.
        # Lifecycle stays two-layer: this shim only bootstraps; the package
        # gms-agent owns everything else.
        import base64
        import hashlib
        import json
        import shutil
        import ssl
        import stat
        import tempfile
        import urllib.error
        import zipfile
        from urllib.parse import urlsplit

        MAX_ARCHIVE_FILES = 5000
        MAX_ARCHIVE_BYTES = 512 * 1024 * 1024

        server = _bootstrap_server()

        def _ssl_context():
            if not server.startswith("https://"):
                return None
            ca_cert = os.environ.get("GMS_INSTALL_CA_CERT", "")
            if ca_cert:
                return ssl.create_default_context(cafile=ca_cert)
            if os.environ.get("GMS_INSTALL_INSECURE") == "1":
                context = ssl.create_default_context()
                context.check_hostname = False
                context.verify_mode = ssl.CERT_NONE
                return context
            return None  # default system verification

        class _NoRedirects(urllib.request.HTTPRedirectHandler):
            # A tampered manifest must not bounce the fetch to another origin.
            def redirect_request(self, req, fp, code, msg, headers, newurl):
                return None

        def http_get(url: str, timeout: int) -> bytes:
            request = urllib.request.Request(
                url, headers={"User-Agent": "gms-agent-bootstrap"}
            )
            if server.startswith("https://"):
                opener = urllib.request.build_opener(
                    urllib.request.HTTPSHandler(context=_ssl_context()),
                    _NoRedirects(),
                )
            else:
                opener = urllib.request.build_opener(_NoRedirects())
            with opener.open(request, timeout=timeout) as response:
                return response.read()

        registry_base = f"{server}/api/agent/packages/gms-remote-test"
        try:
            manifest = json.loads(http_get(f"{registry_base}/manifest", 60))
            artifact = (manifest.get("artifacts") or {}).get("universal") or {}
            artifact_url, expected_sha = artifact.get("url"), str(artifact.get("sha256", ""))
            if not isinstance(artifact_url, str) or not expected_sha:
                raise RuntimeError("清单缺少 universal 包或 SHA-256")
            origin = urlsplit(server)
            parsed = urlsplit(artifact_url)
            if (
                parsed.scheme not in {"http", "https"}
                or not parsed.netloc
                or (parsed.scheme, parsed.netloc) != (origin.scheme, origin.netloc)
            ):
                raise RuntimeError("清单的包下载地址非法（非同源 http/https）")
            data = http_get(artifact_url, 600)
            if hashlib.sha256(data).hexdigest() != expected_sha:
                raise RuntimeError("包 SHA-256 校验失败；拒绝安装")
            verify_key = os.environ.get(
                "GMS_AGENT_VERIFY_KEY_B64",
                # Release public key pinned at bootstrap download time.
                "__GMS_AGENT_VERIFY_KEY_B64__",
            )
            if verify_key.startswith("__GMS_"):
                verify_key = ""
            if verify_key:
                signature = str(manifest.get("signature", ""))
                if not signature:
                    raise RuntimeError("清单缺少 Ed25519 签名；已配置验证密钥时签名强制")
                try:
                    from cryptography.exceptions import InvalidSignature
                    from cryptography.hazmat.primitives import serialization
                    from cryptography.hazmat.primitives.asymmetric.ed25519 import (
                        Ed25519PublicKey,
                    )
                except ImportError as error:
                    raise RuntimeError(
                        "已配置验证密钥但缺少 cryptography 库；拒绝安装"
                    ) from error
                payload = "|".join([
                    str(manifest.get("name", "")),
                    str(manifest.get("version", "")),
                    expected_sha,
                    str(artifact.get("size", "")),
                ]).encode("utf-8")
                try:
                    public_key = serialization.load_pem_public_key(
                        base64.b64decode(verify_key)
                    )
                    if not isinstance(public_key, Ed25519PublicKey):
                        raise RuntimeError("验证密钥类型错误；拒绝安装")
                    public_key.verify(base64.b64decode(signature), payload)
                except (InvalidSignature, ValueError, TypeError):
                    raise RuntimeError("清单 Ed25519 签名校验失败；拒绝安装")

            extract_dir = Path(tempfile.mkdtemp(prefix="gms-agent-bootstrap-"))
            archive_path = extract_dir / "package.zip"
            archive_path.write_bytes(data)
            # Guarded extraction — same contract as
            # gms_agent.package_manager.safe_extract (10.txt §十九): never
            # trust the archive's own paths.
            try:
                with zipfile.ZipFile(archive_path) as archive:
                    entries = archive.infolist()
                    if len(entries) > MAX_ARCHIVE_FILES:
                        raise RuntimeError(
                            f"包内文件数超限（{len(entries)} > {MAX_ARCHIVE_FILES}）"
                        )
                    if sum(entry.file_size for entry in entries) > MAX_ARCHIVE_BYTES:
                        raise RuntimeError("包解压体积超限")
                    dest_resolved = extract_dir.resolve()
                    for entry in entries:
                        name = entry.filename
                        if name.startswith("/") or "\\" in name or ":" in name:
                            raise RuntimeError(f"非法包内路径: {name!r}")
                        parts = PurePosixPath(name).parts
                        if not parts or ".." in parts:
                            raise RuntimeError(f"非法包内路径: {name!r}")
                        target = dest_resolved.joinpath(*parts)
                        if (
                            dest_resolved != target
                            and dest_resolved not in target.parents
                        ):
                            raise RuntimeError(f"包内路径越界: {name!r}")
                        mode = entry.external_attr >> 16
                        if stat.S_IFMT(mode) in (
                            stat.S_IFLNK, stat.S_IFCHR, stat.S_IFBLK,
                            stat.S_IFIFO, stat.S_IFSOCK,
                        ):
                            raise RuntimeError(f"拒绝特殊文件条目: {name!r}")
                        if entry.is_dir():
                            target.mkdir(parents=True, exist_ok=True)
                            continue
                        target.parent.mkdir(parents=True, exist_ok=True)
                        with archive.open(entry) as source, target.open("wb") as sink:
                            shutil.copyfileobj(source, sink)
                        if mode & 0o111:
                            target.chmod(target.stat().st_mode | 0o755)
                archive_path.unlink(missing_ok=True)
            except Exception:
                shutil.rmtree(extract_dir, ignore_errors=True)
                raise
            inner = extract_dir / "gms-remote-test"
            root = inner if (inner / "scripts" / "gms-agent").is_file() else extract_dir
            print("Bootstrapping: fetched the full gms-agent from the Controller.")
            sys.argv = [str(root / "scripts" / "gms-agent"), *sys.argv[1:]]
            sys.path.insert(0, str(root / "scripts"))
            runpy.run_path(str(root / "scripts" / "gms-agent"), run_name="__main__")
            shutil.rmtree(extract_dir, ignore_errors=True)
            return 0
        except SystemExit:
            raise
        except (OSError, ValueError, RuntimeError, zipfile.BadZipFile) as error:
            print(f"Error: bootstrap 失败: {error}", file=sys.stderr)
            return 6

    # Only bootstrap when executed as a script; a bare import (tests loading
    # the standalone copy to inspect local_package_root) must not trigger
    # a network fetch.
    if __name__ == "__main__":
        raise SystemExit(_standalone_main())

    # Imported as a module (no gms_agent package available): expose the
    # minimal surface the lifecycle tests assert on.
    def local_package_root(arg_package: str, script_dir: Path | None = None):  # noqa: F811
        from pathlib import Path as _P

        if arg_package:
            root = _P(arg_package).resolve()
            for scripts_dir in ("scripts", "runtime"):
                marker = root / scripts_dir / "gms-remote-test.sh"
                if marker.is_file():
                    return root
            return None
        base = _P(script_dir).resolve() if script_dir else SCRIPT_DIR
        for scripts_dir in ("scripts", "runtime"):
            if (base.parent / scripts_dir / "gms-remote-test.sh").is_file():
                return base.parent
        return None

    def cli_version_in(root):  # noqa: F811
        for scripts_dir in ("scripts", "runtime"):
            marker = Path(root) / scripts_dir / "gms-remote-test.sh"
            if marker.is_file():
                for line in marker.read_text(encoding="utf-8").splitlines():
                    if line.startswith("GMS_RT_VERSION="):
                        return line.split("=", 1)[1].strip().strip('"') or None
        return None

    def runtime_version() -> str:  # noqa: F811
        return cli_version_in(SCRIPT_DIR.parent) or "unknown"

from gms_agent.package_manager import (  # noqa: E402
    activate_clients,
    artifact_url_ok,
    client_skill_root,
    cmd_enroll,
    cmd_install,
    cmd_rollback,
    cmd_status,
    cmd_update,
    cli_version_in,
    configured_clients,
    detect_clients,
    fetch_registry_package,
    install_cli_dispatcher,
    install_plugin_for_kkagent,
    install_runtime,
    install_skill,
    installed_version,
    local_package_root,
    package_tree_sha256,
    profile_name,
    profile_server_and_ca,
    reconcile_mcp,
    runtime_version,
    safe_extract,
    write_profile,
)
from gms_agent.package_manager import MAX_ARCHIVE_FILES, MAX_ARCHIVE_BYTES  # noqa: E402,F401
import gms_agent.package_manager as _pm  # noqa: E402
import shutil as _shutil  # noqa: E402,F401  (re-export for tests/compat)

# Lifecycle functions read module globals from package_manager; tests and
# embedders patch states through this handle (see test_agent_package_lifecycle).
pm = _pm
shutil = _shutil

import argparse  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(prog="gms-agent", description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    p_install = sub.add_parser("install", help="install runtime + skill + MCP for detected clients")
    p_install.add_argument("--client", default="auto", choices=["auto", "codex", "kimi", "kkagent"])
    p_install.add_argument("--server", default="", help="Controller base URL (default $GMS_REMOTE_TEST_SERVER)")
    p_install.add_argument("--package", default="", help="package root to install (default: this archive; standalone script bootstraps from the registry)")
    p_install.set_defaults(func=cmd_install)

    p_update = sub.add_parser("update", help="update from the Controller Agent Package Registry")
    p_update.add_argument("--server", default="")
    p_update.add_argument("--force", action="store_true")
    p_update.set_defaults(func=cmd_update)

    p_rollback = sub.add_parser("rollback", help="switch `current` (and every client) back to an installed version")
    p_rollback.add_argument("version")
    p_rollback.set_defaults(func=cmd_rollback)

    p_enroll = sub.add_parser("enroll", help="exchange a one-shot enrollment code for a service token")
    p_enroll.add_argument("code")
    p_enroll.add_argument("--server", default="")
    p_enroll.set_defaults(func=cmd_enroll)

    p_status = sub.add_parser("status", help="show installation state")
    p_status.set_defaults(func=cmd_status)

    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
