# 本机部署配置与秘密：整个 configs/ 默认忽略，只放行白名单模板与说明文档。
# 策略见 docs/deployment/configuration.md 与 configs/README.md。
/configs/*
!/configs/examples/
/configs/examples/*
!/configs/examples/config.example.json
!/configs/examples/runtime.example.json
!/configs/examples/build_servers.example.json
!/configs/examples/automation_profiles.example.json
!/configs/examples/cluster.example.json
!/configs/README.md
!/configs/AGENTS.md

# 运行数据全部忽略（可再生数据与含敏感数据的迁移备份）
/data/

# 构建与前端产物（仅根级；tools/ 下已跟踪的 dist 产物不受影响）
/dist/

# Python 运行产物（fresh-clone 契约：test_config_examples.py 依赖本规则
# 遮蔽运行时本地文件）
__pycache__/
*.pyc
.pytest_cache/

# 第三方知识库本地 clone：按需用 tools/scripts/setup/update_android_internals_wiki.sh
# 拉取/更新，不纳入主仓库版本控制（40.txt 重构方案）。
/tools/android-internals-wiki/

# usbip/adbproxy-rs/jadx：目录只保留可执行工件与目录级 *.provenance.json，
# 源码/上游发行文档不入主仓库（各目录溯源见各自 provenance 文件；
# usbip fork: weixin1263831586/usbip，upstream: jiegec/usbip）。
/tools/usbip/*
!/tools/usbip/usbipd
!/tools/usbip/usbipd.provenance.json

/tools/adbproxy-rs/*
!/tools/adbproxy-rs/adbproxy-rs.provenance.json
!/tools/adbproxy-rs/dist/

/tools/jadx/*
!/tools/jadx/bin/
!/tools/jadx/lib/
!/tools/jadx/jadx.provenance.json
