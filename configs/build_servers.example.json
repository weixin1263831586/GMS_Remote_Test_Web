{
  "_comment": "Copy to configs/build_servers.json for local deployment. Hosts, users and workspaces below are placeholders; passwords come from environment variables.",
  "servers": [
    {
      "id": "example-build-server",
      "name": "Example Build Server",
      "host": "192.0.2.10",
      "port": 22,
      "username": "builder",
      "backend": "ssh",
      "auth": {
        "type": "env_password",
        "env": "BUILD_SERVER_PASSWORD"
      },
      "workspace_root": "/home/builder",
      "max_concurrent_jobs": 1,
      "artifact_patterns": [
        "rockdev/Image-*/update.img",
        "rockdev/pack/*.img",
        "out/target/product/*/*.img",
        "IMG/IMAGES/*.img"
      ]
    }
  ],
  "templates": [
    {
      "id": "example-android-build",
      "name": "Example Android Firmware Build",
      "description": "Run a controlled Android firmware build on example-build-server.",
      "server_id": "example-build-server",
      "workspace": "{workspace}",
      "init_commands": [
        "source build/envsetup.sh",
        "lunch {lunch_target}"
      ],
      "command": "{build_command}",
      "timeout_sec": 21600,
      "artifact_patterns": [
        "rockdev/Image-*/update.img",
        "rockdev/pack/*.img",
        "out/target/product/*/*.img",
        "IMG/IMAGES/*.img"
      ],
      "parameters_schema": {
        "workspace": {
          "type": "string",
          "required": true,
          "validation": "standard"
        },
        "lunch_target": {
          "type": "string",
          "required": true,
          "validation": "standard"
        },
        "build_command": {
          "type": "string",
          "default": "./build.sh -UCKApu -J 8",
          "validation": "trusted_shell_fragment",
          "pattern": "^\\./build\\.sh [A-Za-z0-9 ._/-]*",
          "choices": [
            "./build.sh -UCKApu -J 8",
            "./build.sh -UCKApu -J 16",
            "./build.sh -UCKApu -J 32"
          ]
        }
      },
      "enabled": true
    }
  ]
}
