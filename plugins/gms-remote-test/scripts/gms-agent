#!/usr/bin/env python3
"""gms-agent — one installer, one updater, one enrollment (10.txt §十三~§十六).

The single user-facing entry point of the GMS Agent Runtime on a build
server. Users should never need to know about ~/.codex/config.toml,
~/.kimi-code/mcp.json, ~/.kkagent/plugins, GMS_AUTH_TOKEN_FILE or
GMS_RT_PROFILE — those become implementation details:

    gms-agent install [--client auto|codex|kimi|kkagent] [--server URL] [--yes]
        Detect installed agent clients, install the bundled runtime
        (skill + MCP server + launcher + gms-rt CLI), write per-client
        profiles and reconcile the MCP registrations.

    gms-agent update
        Check the Controller Agent Package Registry for a newer version,
        download + verify (SHA-256), atomically install into
        versions/<new>/ and flip the `current` symlink (old version kept
        for instant rollback; `gms-agent rollback` flips back).

    gms-agent enroll <CODE>
        Exchange a one-shot enrollment code for an Agent Service Token
        (0600) and wire it into every installed client profile.

    gms-agent status
        Show installed version, detected clients, profile and auth state.

The installer lives inside the distributed package (skills/.../scripts/),
so `install` works from the extracted archive; `update` requires the
Controller registry endpoints (Phase 3, /api/agent/packages/...).
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import shutil
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
RUNTIME_ROOT = Path(
    os.environ.get(
        "GMS_AGENT_RUNTIME_ROOT",
        Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
        / "gms-remote-test",
    )
)
VERSIONS_DIR = RUNTIME_ROOT / "versions"
CURRENT_LINK = RUNTIME_ROOT / "current"
MCP_ENV_DIR = RUNTIME_ROOT / "mcp"
STATE_DIR = Path(
    os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")
) / "gms-remote-test"
CONFIG_DIR = Path(
    os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")
) / "gms-agent"

CLIENTS = ("codex", "kimi", "kkagent")


def detect_clients() -> list[str]:
    found = []
    if Path(os.environ.get("CODEX_HOME", Path.home() / ".codex")).is_dir() or shutil.which("codex"):
        found.append("codex")
    if Path(os.environ.get("KIMI_CODE_HOME", Path.home() / ".kimi-code")).is_dir() or shutil.which("kimi"):
        found.append("kimi")
    if Path(os.environ.get("KKAGENT_HOME", Path.home() / ".kkagent")).is_dir() or shutil.which("kkagent"):
        found.append("kkagent")
    return found


def runtime_version() -> str:
    """Version of the running package (this file's checkout/archive)."""
    marker = SCRIPT_DIR / "gms-remote-test.sh"
    if marker.is_file():
        for line in marker.read_text(encoding="utf-8").splitlines():
            if line.startswith("GMS_RT_VERSION="):
                return line.split("=", 1)[1].strip().strip('"')
    return "unknown"


def installed_version() -> str | None:
    target = CURRENT_LINK.resolve() if CURRENT_LINK.exists() else None
    if target and (target / "scripts" / "gms-remote-test.sh").is_file():
        return target.name
    return None


def client_skill_root(client: str) -> Path:
    if client == "kimi":
        return Path(os.environ.get("KIMI_CODE_HOME", Path.home() / ".kimi-code")) / "skills"
    if client == "kkagent":
        return Path(os.environ.get("KKAGENT_HOME", Path.home() / ".kkagent")) / "skills"
    return Path(
        os.environ.get("GMS_CODEX_SKILLS_DIR")
        or (Path(os.environ.get("CODEX_HOME", Path.home() / ".codex")) / "skills")
    )


def profile_name(client: str) -> str:
    host = socket.gethostname().split(".")[0]
    return f"{client}-{host}-{os.getuid()}"


def server_url_from_env() -> str:
    url = (
        os.environ.get("GMS_REMOTE_TEST_SERVER", "")
        # Bootstrap installs embed the Controller URL at download time
        # (GET /api/agent/install); an explicit env var still wins.
        or "__GMS_AGENT_DEFAULT_SERVER__"
    )
    if not url or url.startswith("__GMS_"):
        print(
            "Error: GMS_REMOTE_TEST_SERVER 未设置（gms-agent 不会猜测 Controller 地址）",
            file=sys.stderr,
        )
        raise SystemExit(2)
    return url.rstrip("/")


def http_get(url: str, ca_cert: str = "", timeout: int = 60) -> tuple[bytes, dict[str, str]]:
    context = None
    if url.startswith("https://"):
        import ssl

        if ca_cert:
            context = ssl.create_default_context(cafile=ca_cert)
        elif os.environ.get("GMS_INSTALL_INSECURE") == "1":
            context = ssl.create_default_context()
            context.check_hostname = False
            context.verify_mode = ssl.CERT_NONE
    request = urllib.request.Request(url, headers={"User-Agent": "gms-agent-installer"})
    with urllib.request.urlopen(request, timeout=timeout, context=context) as response:
        return response.read(), dict(response.headers)


# ---------------------------------------------------------------------------
# install
# ---------------------------------------------------------------------------

def copytree_atomic(source: Path, target: Path) -> None:
    if target.exists():
        shutil.rmtree(target)
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copytree(source, target)


def install_runtime(source_root: Path) -> Path:
    """Copy the package into versions/<ver>/ and flip `current` atomically."""
    version = runtime_version()
    target = VERSIONS_DIR / version
    staging = VERSIONS_DIR / f".staging-{version}-{os.getpid()}"
    if staging.exists():
        shutil.rmtree(staging)
    staging.parent.mkdir(parents=True, exist_ok=True)
    shutil.copytree(source_root, staging, ignore=shutil.ignore_patterns("__pycache__"))
    if target.exists():
        shutil.rmtree(target)
    staging.rename(target)
    # Atomic flip: symlink swap via os.replace on a temp link.
    tmp_link = CURRENT_LINK.with_name(f".current-{os.getpid()}")
    if tmp_link.exists() or tmp_link.is_symlink():
        tmp_link.unlink()
    tmp_link.symlink_to(target)
    os.replace(tmp_link, CURRENT_LINK)
    return target


def install_skill(client: str, runtime_dir: Path) -> Path:
    source_skill = runtime_dir / "skills" / "gms-remote-test"
    target = client_skill_root(client) / "gms-remote-test"
    copytree_atomic(source_skill, target)
    print(f"  Skill ({client}): {target}")
    return target


def write_profile(client: str, server: str, ca_cert: str) -> str:
    name = profile_name(client)
    token_file = STATE_DIR / f"{name}.token"
    MCP_ENV_DIR.mkdir(parents=True, exist_ok=True)
    lines = [
        f"export GMS_REMOTE_TEST_SERVER={json.dumps(server)}",
        f"export GMS_RT_PROFILE={json.dumps(name)}",
        f"export GMS_AUTH_TOKEN_FILE={json.dumps(str(token_file))}",
        "export GMS_AGENT_AUTH_MODE=service-token",
    ]
    if ca_cert:
        lines.append(f"export GMS_CURL_CA_CERT={json.dumps(ca_cert)}")
    env_file = MCP_ENV_DIR / f"{client}.env"
    env_file.write_text("\n".join(lines) + "\n", encoding="utf-8")
    env_file.chmod(0o600)
    return name


def reconcile_mcp(client: str, server: str, name: str, ca_cert: str) -> None:
    token_file = STATE_DIR / f"{name}.token"
    mcp_server = str(CURRENT_LINK / "scripts" / "mcp_server.py")
    result = subprocess.run(
        [
            sys.executable,
            str(CURRENT_LINK / "scripts" / "agent_mcp_config.py"),
            client,
            str(
                client_skill_root(client).parent
                / ("mcp.json" if client == "kimi" else "config.toml" if client == "codex" else "plugins/gms-remote-test")
            )
            if client != "kkagent"
            else "",  # kkagent registers via the plugin payload, not a config file
            mcp_server,
            server,
            name,
            str(token_file),
            ca_cert,
        ],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        print(f"  MCP ({client}): reconcile failed — {result.stderr.strip()}", file=sys.stderr)
        raise SystemExit(1)
    print(f"  MCP ({client}): {result.stdout.strip()}")


def install_plugin_for_kkagent(runtime_dir: Path) -> None:
    """Register the bundled plugin payload under ~/.kkagent/plugins."""
    kkagent_home = Path(os.environ.get("KKAGENT_HOME", Path.home() / ".kkagent"))
    source = runtime_dir.parent  # archive layout: gms-remote-test/...
    payload = source / "plugins" / "gms-remote-test"
    if not (payload / "kk.plugin.json").is_file():
        payload = runtime_dir / "plugins" / "gms-remote-test"
    if not (payload / "kk.plugin.json").is_file():
        print("  MCP (kkagent): plugin payload not found in package; skipped", file=sys.stderr)
        return
    target = kkagent_home / "plugins" / "gms-remote-test"
    copytree_atomic(payload, target)
    print(f"  MCP (kkagent): plugin installed at {target}")


def cmd_install(args: argparse.Namespace) -> int:
    source_root = Path(args.package).resolve() if args.package else SCRIPT_DIR.parent.parent
    server = args.server or server_url_from_env()
    ca_cert = os.environ.get("GMS_INSTALL_CA_CERT", "")

    clients = detect_clients() if args.client == "auto" else [args.client]
    if not clients:
        print("未检测到 codex/kimi/kkagent；将仅安装运行时与 CLI。")

    print(f"Installing GMS Agent Runtime {runtime_version()}")
    runtime_dir = install_runtime(source_root)
    print(f"  Runtime: {CURRENT_LINK} -> {runtime_dir}")

    # gms-rt dispatcher on PATH.
    bin_dir = Path(os.environ.get("GMS_BIN_DIR", Path.home() / ".local/bin"))
    bin_dir.mkdir(parents=True, exist_ok=True)
    dispatcher = bin_dir / "gms-rt"
    dispatcher.write_text(
        "#!/usr/bin/env bash\n"
        f'exec bash "{CURRENT_LINK}/scripts/gms-remote-test.sh" "$@"\n',
        encoding="utf-8",
    )
    dispatcher.chmod(0o755)
    print(f"  CLI: {dispatcher}")

    for client in clients:
        print(f"Configuring {client}:")
        name = write_profile(client, server, ca_cert)
        install_skill(client, runtime_dir)
        if client == "kkagent":
            install_plugin_for_kkagent(runtime_dir)
        else:
            config_path = client_skill_root(client).parent / (
                "mcp.json" if client == "kimi" else "config.toml"
            )
            token_file = STATE_DIR / f"{name}.token"
            mcp_server = str(CURRENT_LINK / "scripts" / "mcp_server.py")
            script = runtime_dir / "scripts" / "agent_mcp_config.py"
            result = subprocess.run(
                [sys.executable, str(script), client, str(config_path), mcp_server,
                 server, name, str(token_file), ca_cert],
                capture_output=True, text=True,
            )
            if result.returncode != 0:
                print(f"  MCP ({client}): {result.stderr.strip()}", file=sys.stderr)
                return 1
            print(f"  MCP ({client}): {result.stdout.strip()}")

    print("\nDetected & configured:", ", ".join(clients) if clients else "(none)")
    print("Next: create an enrollment code in the Controller web UI, then run:")
    print(f"  gms-agent enroll <CODE>")
    return 0


# ---------------------------------------------------------------------------
# update (Controller Agent Package Registry)
# ---------------------------------------------------------------------------

def registry_base(server: str) -> str:
    return f"{server}/api/agent/packages/gms-remote-test"


def cmd_update(args: argparse.Namespace) -> int:
    server = args.server or server_url_from_env()
    ca_cert = os.environ.get("GMS_INSTALL_CA_CERT", "")
    current = installed_version() or runtime_version()
    try:
        raw, _headers = http_get(f"{registry_base(server)}/manifest", ca_cert)
        manifest = json.loads(raw)
    except (urllib.error.URLError, OSError, ValueError) as error:
        print(f"Error: 无法读取 Controller 包清单: {error}", file=sys.stderr)
        return 6
    latest = str(manifest.get("version", ""))
    if not latest:
        print("Error: Controller 清单缺少 version", file=sys.stderr)
        return 7
    if latest == current and not args.force:
        print(f"Already up to date: {current}")
        return 0
    artifact = (manifest.get("artifacts") or {}).get("universal") or {}
    artifact_url = artifact.get("url")
    expected_sha = str(artifact.get("sha256", ""))
    if not artifact_url_ok(artifact_url):
        print("Error: 清单缺少 universal 包下载地址", file=sys.stderr)
        return 7
    print(f"Updating {current} -> {latest}")
    archive_path = VERSIONS_DIR / f"gms-remote-test-{latest}.zip"
    VERSIONS_DIR.mkdir(parents=True, exist_ok=True)
    try:
        data, headers = http_get(artifact_url, ca_cert, timeout=600)
    except (urllib.error.URLError, OSError) as error:
        print(f"Error: 包下载失败: {error}", file=sys.stderr)
        return 6
    if expected_sha and hashlib.sha256(data).hexdigest() != expected_sha:
        print("Error: 包 SHA-256 校验失败；拒绝安装", file=sys.stderr)
        return 7
    archive_path.write_bytes(data)

    extract_dir = VERSIONS_DIR / f".update-{latest}-{os.getpid()}"
    import zipfile

    with zipfile.ZipFile(archive_path) as archive:
        archive.extractall(extract_dir)
    # The archive root is gms-remote-test/ — find the inner package root.
    inner = extract_dir / "gms-remote-test"
    source_root = inner if (inner / "scripts").is_dir() else extract_dir
    installed_dir = install_runtime(source_root)
    shutil.rmtree(extract_dir, ignore_errors=True)
    archive_path.unlink(missing_ok=True)
    print(f"Installed: {CURRENT_LINK} -> {installed_dir}")
    print("Profiles and tokens preserved. Restart agents to pick up the new runtime.")
    print(f"Rollback anytime: gms-agent rollback {current}")
    return 0


def artifact_url_ok(url: object) -> bool:
    return isinstance(url, str) and url.startswith(("https://", "http://"))


def cmd_rollback(args: argparse.Namespace) -> int:
    version = args.version
    target = VERSIONS_DIR / version
    if not (target / "scripts" / "gms-remote-test.sh").is_file():
        print(f"Error: 未安装版本 {version}", file=sys.stderr)
        return 2
    tmp_link = CURRENT_LINK.with_name(f".current-{os.getpid()}")
    if tmp_link.exists() or tmp_link.is_symlink():
        tmp_link.unlink()
    tmp_link.symlink_to(target)
    os.replace(tmp_link, CURRENT_LINK)
    print(f"Rolled back: {CURRENT_LINK} -> {target}")
    return 0


# ---------------------------------------------------------------------------
# enroll
# ---------------------------------------------------------------------------

def cmd_enroll(args: argparse.Namespace) -> int:
    server = args.server or server_url_from_env()
    code = args.code
    if not code:
        print("Error: 需要 one-shot enrollment code", file=sys.stderr)
        return 2
    data = json.dumps({"code": code}).encode("utf-8")
    request = urllib.request.Request(
        f"{server}/api/auth/agent-enroll",
        data=data,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    import ssl

    context = None
    if server.startswith("https://"):
        ca = os.environ.get("GMS_INSTALL_CA_CERT", "")
        if ca:
            context = ssl.create_default_context(cafile=ca)
        elif os.environ.get("GMS_INSTALL_INSECURE") == "1":
            context = ssl.create_default_context()
            context.check_hostname = False
            context.verify_mode = ssl.CERT_NONE
    try:
        with urllib.request.urlopen(request, timeout=60, context=context) as response:
            body = json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as error:
        detail = error.read().decode("utf-8", "replace")[:300]
        print(f"Error: enrollment 失败: HTTP {error.code} {detail}", file=sys.stderr)
        return 4
    except (urllib.error.URLError, OSError, ValueError) as error:
        print(f"Error: enrollment 失败: {error}", file=sys.stderr)
        return 6
    token = (body.get("token") or {}).get("token", "")
    scopes = (body.get("token") or {}).get("scopes", [])
    if not token:
        print("Error: 响应缺少 token", file=sys.stderr)
        return 7
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(STATE_DIR, 0o700)
    # One token per profile client so revocation stays per-agent; profiles
    # were written by `install` for every detected client.
    written = []
    for client in [*detect_clients(), "kkagent"]:
        env_file = MCP_ENV_DIR / f"{client}.env"
        if not env_file.is_file():
            continue
        profile_line = next(
            (line for line in env_file.read_text(encoding="utf-8").splitlines()
             if line.startswith("export GMS_RT_PROFILE=")), ""
        )
        if not profile_line:
            continue
        profile = profile_line.split("=", 1)[1].strip().strip('"')
        token_file = STATE_DIR / f"{profile}.token"
        token_file.write_text(token + "\n", encoding="utf-8")
        token_file.chmod(0o600)
        written.append(str(token_file))
    for path in written:
        print(f"Agent token enrolled (0600): {path}")
    if scopes:
        print(f"Scopes: {', '.join(scopes)}")
    return 0


# ---------------------------------------------------------------------------
# status
# ---------------------------------------------------------------------------

def cmd_status(_args: argparse.Namespace) -> int:
    print(f"Runtime:      {runtime_version()} (installed: {installed_version() or 'none'})")
    print(f"Runtime root: {RUNTIME_ROOT}")
    print(f"Detected:     {', '.join(detect_clients()) or '(none)'}")
    for client in detect_clients():
        env_file = MCP_ENV_DIR / f"{client}.env"
        state = "configured" if env_file.is_file() else "not configured"
        token_ref = ""
        if env_file.is_file():
            for line in env_file.read_text(encoding="utf-8").splitlines():
                if line.startswith("export GMS_AUTH_TOKEN_FILE="):
                    ref = Path(line.split("=", 1)[1].strip().strip('"'))
                    token_ref = " + token" if ref.is_file() else " + token MISSING"
        print(f"  {client}: {state}{token_ref}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(prog="gms-agent", description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    p_install = sub.add_parser("install", help="install runtime + skill + MCP for detected clients")
    p_install.add_argument("--client", default="auto", choices=["auto", "codex", "kimi", "kkagent"])
    p_install.add_argument("--server", default="", help="Controller base URL (default $GMS_REMOTE_TEST_SERVER)")
    p_install.add_argument("--package", default="", help="package root to install (default: this archive)")
    p_install.set_defaults(func=cmd_install)

    p_update = sub.add_parser("update", help="update from the Controller Agent Package Registry")
    p_update.add_argument("--server", default="")
    p_update.add_argument("--force", action="store_true")
    p_update.set_defaults(func=cmd_update)

    p_rollback = sub.add_parser("rollback", help="switch `current` back to an installed version")
    p_rollback.add_argument("version")
    p_rollback.set_defaults(func=cmd_rollback)

    p_enroll = sub.add_parser("enroll", help="exchange a one-shot enrollment code for a service token")
    p_enroll.add_argument("code")
    p_enroll.add_argument("--server", default="")
    p_enroll.set_defaults(func=cmd_enroll)

    p_status = sub.add_parser("status", help="show installation state")
    p_status.set_defaults(func=cmd_status)

    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
